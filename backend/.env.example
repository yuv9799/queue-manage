# Backend environment (copy to .env and adjust for your host)

# Port the API listens on (most hosts inject this)
PORT=8080

# Node environment. When 'production', the demo-OTP bypass is disabled and a
# real OTP provider must be wired into routes/otp.js.
NODE_ENV=development

# Comma-separated list of additional allowed CORS origins (besides the built-ins
# which already include https://yuv9799.github.io and localhost dev origins).
# CORS_ORIGINS=https://example.com,https://other.example.com