# Frontend environment (Vite exposes only VITE_-prefixed vars to the client).
# Copy to .env for local dev or set during the production build.
#
# LOCAL DEV (default if unset): the app calls http://localhost:8080
# VITE_API_URL=http://localhost:8080
#
# PRODUCTION (required): the URL of the DEPLOYED backend. GitHub Pages is
# static-only and cannot host the API, so you must host the backend elsewhere
# and point the build at it. Example (do NOT use a fake URL):
# VITE_API_URL=https://your-backend-host.example.com